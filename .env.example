# --- Supabase (local via `pnpm db:start`) ---
# Récupérez les valeurs avec `pnpm db:status` (ou affichées par `supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connexion Postgres directe (utilisée par Better Auth via Kysely)
# Local : base `postgres`, port 54322, utilisateur/mot de passe `postgres`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Better Auth ---
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Admin (compte unique créé via `pnpm db:admin`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Site public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel : envoi du formulaire de contact vers un endpoint (webhook/email)
# CONTACT_WEBHOOK_URL=
