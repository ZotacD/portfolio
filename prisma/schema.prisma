// Prisma schema — source de vérité de la base de données.
// Conventions : champs camelCase, colonnes Postgres snake_case via `@map`.
// (Auth) Les modèles User/Session/Account/Verification sont ceux de Better Auth
// (adaptateur Prisma) : leurs noms de champs camelCase sont imposés.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Better Auth ----------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @db.Timestamptz(6)  @default(now()) @map("created_at")
  updatedAt     DateTime @db.Timestamptz(6)  @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  token     String   @unique
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6) @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6) @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime @db.Timestamptz(6)  @default(now()) @map("created_at")
  updatedAt             DateTime @db.Timestamptz(6)  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6) @map("expires_at")
  createdAt  DateTime @db.Timestamptz(6) @default(now()) @map("created_at")
  updatedAt  DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  @@map("verification")
}

// ---------- Métier ----------

enum ProjectStatus {
  draft
  published
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  excerpt     String?
  description String?
  coverUrl    String?       @map("cover_url")
  linkUrl     String?       @map("link_url")
  tags        String[]      @default([])
  status      ProjectStatus @default(draft)
  sortOrder   Int           @default(0) @map("sort_order")
  publishedAt DateTime? @db.Timestamptz(6)     @map("published_at")
  createdAt   DateTime @db.Timestamptz(6)      @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamptz(6)      @updatedAt @map("updated_at")

  files  ProjectFile[]
  images ProjectImage[]

  @@map("projects")
}

model ProjectFile {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  storagePath String   @map("storage_path")
  mimeType    String?  @map("mime_type")
  size        BigInt?
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model ProjectImage {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  storagePath String   @map("storage_path")
  alt         String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model Profile {
  id        Int      @id @default(1)
  name      String?
  title     String?
  bio       String?
  email     String?
  phone     String?
  location  String?
  social    Json?
  updatedAt DateTime @db.Timestamptz(6) @updatedAt @map("updated_at")

  @@map("profile")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @db.Timestamptz(6) @default(now()) @map("created_at")

  @@map("contact_messages")
}
